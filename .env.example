# Nakama Just Dance — k6 Load Test Environment
# Copy to .env and fill in values. Never commit .env with real secrets.
# Windows launchers (run-smoke.bat, run-10.bat, run-50.bat, run-100.bat)
# load this file automatically. You do not need to `set` keys in the shell.

NAKAMA_HOST=85.198.11.216
NAKAMA_PORT=7350
NAKAMA_USE_TLS=false

NAKAMA_SERVER_KEY=your_socket_server_key_here
NAKAMA_HTTP_KEY=your_http_key_here

# Profile: light | medium | heavy (set by run-10/50/100.bat)
LOAD_PROFILE=light

# 1:1 model — MOBILE_PLAYERS must equal TV_SESSIONS (= k6 VUs)
# 10 VU LIGHT:   MOBILE_PLAYERS=10, TV_SESSIONS=10 (20 clients)  ← current phase
# 25 VU MEDIUM:  MOBILE_PLAYERS=25, TV_SESSIONS=25 (50 clients)  ← configured, not run
# 50 VU HEAVY:   MOBILE_PLAYERS=50, TV_SESSIONS=50 (100 clients) ← configured, not run
SCENARIO=gameplay
MOBILE_PLAYERS=10
TV_SESSIONS=10

COUNTDOWN_MS=10000
VIDEO_DURATION_MS=60000
SCORE_INTERVAL_MS=1000
FRAME_SYNC_INTERVAL_MS=250
SERVER_TIME_INTERVAL_MS=30000

RAMP_UP=15s
STEADY_DURATION=0s
RAMP_DOWN=10s

THRESHOLD_HTTP_FAILED=0.05
THRESHOLD_CHECKS=0.95
THRESHOLD_PAIRING_SUCCESS=0.95
THRESHOLD_GAME_COMPLETION=0.95

SKIP_CLEANUP=false
